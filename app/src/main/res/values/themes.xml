<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      DayNight parent lets AppCompat widgets (dialogs, pickers) follow the theme.
      The status/navigation bars are transparent: Compose owns icon contrast through
      DriveSystemBarAppearance, and edge-to-edge is enabled in MainActivity.
    -->
    <style name="Theme.DrivePartner" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/drive_blue_primary</item>
        <item name="colorPrimaryDark">@color/drive_blue_dark</item>
        <item name="colorAccent">@color/drive_blue_light</item>
        <item name="android:windowBackground">@color/drive_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
