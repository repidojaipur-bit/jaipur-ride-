# Drive Partner Backend Environment Configuration (Supabase + PostgreSQL + PostGIS)
# Copy to .env for local development. NEVER commit .env or any SUPABASE_SECRET_KEY.

NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# PostgreSQL + PostGIS connection string (Supabase Postgres pooler or local Docker)
# Example Supabase Postgres URL (enable PostGIS extension in Supabase -> Database -> Extensions):
# DATABASE_URL=postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://drivepartner:drivepartner_local@localhost:5432/drive_partner
PG_SSL=auto

# Authentication:
# - supabase: validates Supabase Auth JWTs via SUPABASE_JWKS_URL (RS256/ES256)
# - hs256-dev: validates HMAC-SHA256 tokens for local/CI tests (blocked in production)
AUTH_MODE=supabase
SUPABASE_URL=https://zdkoqxkxeayimjzqxfvi.supabase.co
SUPABASE_JWKS_URL=https://zdkoqxkxeayimjzqxfvi.supabase.co/auth/v1/.well-known/jwks.json
# Server-side privileged key ONLY (used for private Storage upload signing; NEVER embed in Android app/)
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=drive-partner-kyc-private

JWT_DEV_SECRET=

# Admin / Back-office operator key (required for /api/v1/admin/* endpoints)
ADMIN_API_KEY=

# Payout & Safety Gate Flags
LIVE_PAYOUTS_ENABLED=false
PAYOUT_WEBHOOK_SECRET=
SOS_RESPONDER_WEBHOOK_URL=
CORS_ALLOWED_ORIGINS=https://localhost
