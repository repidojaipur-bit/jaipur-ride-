{
  "name": "drive-partner-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Drive Partner transactional TypeScript backend (PostgreSQL + PostGIS + Fastify + WebSocket)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "tsx src/db/migrate.ts",
    "seed:dev": "tsx src/db/seed-dev.ts",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
